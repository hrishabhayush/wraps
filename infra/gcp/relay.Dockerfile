# Build context is the repository root. Node's amd64 manifest digest was read
# from the Docker Official Image page for node:22.23.4-bookworm-slim.
FROM --platform=linux/amd64 node:22.23.4-bookworm-slim@sha256:ea11b74b986d520137cdef9a5346e447a00f275ecc4abc0055b7151226231e09 AS build
WORKDIR /repo

COPY package.json package-lock.json tsconfig.json ./
COPY infra/gcp/relay-entrypoint.ts ./infra/gcp/relay-entrypoint.ts
COPY packages/relay/ ./packages/relay/
COPY packages/issuer/ ./packages/issuer/
COPY packages/attestation/ ./packages/attestation/
COPY packages/tokens/ ./packages/tokens/
COPY infra/gcp/expected.json ./infra/gcp/expected.json

# The lockfile pins all workspace dependencies. Only the relay's required
# workspaces and the root build tools are installed into this build stage.
RUN npm ci --no-audit --no-fund --ignore-scripts --include-workspace-root \
    --workspace @wraps/relay \
    --workspace @wraps/issuer \
    --workspace @wraps/attestation \
    --workspace @wraps/tokens
RUN ./node_modules/.bin/esbuild infra/gcp/relay-entrypoint.ts \
    --bundle --platform=node --format=esm --target=node22 --legal-comments=none \
    "--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);" \
    --outfile=/out/relay.mjs

# Runtime: only the pinned Node image and bundled relay workload are shipped.
FROM --platform=linux/amd64 node:22.23.4-bookworm-slim@sha256:ea11b74b986d520137cdef9a5346e447a00f275ecc4abc0055b7151226231e09
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends wireguard-tools iproute2 iptables procps \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/relay.mjs ./relay.mjs
COPY infra/gcp/expected.json ./expected.json

ENV NODE_ENV=production \
    ATTESTATION=confidential-space \
    EXPECTED_JSON=/app/expected.json \
    RELAY_PROXY_HOST=0.0.0.0 \
    RELAY_PROXY_PORT=443 \
    RELAY_ATTESTATION_HOST=0.0.0.0 \
    RELAY_ATTESTATION_PORT=8080 \
    TZ=UTC

EXPOSE 443/tcp 8080/tcp 51820/udp
LABEL "tee.launch_policy.log_redirect"="debugonly"
LABEL "tee.launch_policy.allow_env_override"="ATTESTATION_AUDIENCE,ISSUER_URL,RELAY_HOSTNAME,WG_ENABLED,WG_ENDPOINT,WG_LISTEN_PORT,WG_INTERFACE_ADDRESS,WG_EGRESS_INTERFACE,WG_PEERS_JSON"
LABEL "tee.launch_policy.allow_capabilities"="true"

# The provider reads the Confidential Space launcher socket; TLS key material
# is generated by the entrypoint in process memory after the container starts.
CMD ["node", "/app/relay.mjs"]
