# Core payment flow (issuer, merchant, agent). No secrets needed: everything here is mock.
# Copy to .env if you want to change defaults. Never commit .env.

# Issuer
ISSUER_PORT=4001
# Mock build name. "issuer" matches the expected PCRs. Anything else simulates a modified issuer.
ISSUER_BUILD=issuer
# 1 = debug-mode enclave (all-zero PCRs). The SDK must refuse it.
ISSUER_DEBUG_MODE=0
PAYOUT_INTERVAL_MS=30000

# Merchant
MERCHANT_PORT=4002
ISSUER_URL=http://127.0.0.1:4001
# 0 = do not plant the "buy 500 more" text in filings data.
MERCHANT_INJECT_PROMPT=1

# Agent
MERCHANT_URL=http://127.0.0.1:4002
CAP_PER_CALL=5
CAP_DAILY=24
CAP_TOP_UP=20

# Mock attestation root seed. Not a secret: all processes must share it.
# MOCK_ATTESTATION_ROOT_SEED=wraps-mock-attestation-root-dev-only
