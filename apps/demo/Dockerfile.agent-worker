# Local live-demo worker. Its container namespace is the egress boundary; the
# UI, XRPL spy, local merchant and Cloudflare Tunnel remain on the host.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS build
WORKDIR /repo
COPY package.json package-lock.json tsconfig.json ./
COPY packages ./packages
COPY apps/demo/package.json ./apps/demo/package.json
COPY apps/demo/src/agent-worker.ts ./apps/demo/src/agent-worker.ts
COPY scripts/live-config.ts ./scripts/live-config.ts
RUN npm ci --no-audit --no-fund --ignore-scripts --include-workspace-root --workspace @wraps/demo
RUN mkdir /out && ./node_modules/.bin/esbuild apps/demo/src/agent-worker.ts \
    --bundle --platform=node --format=esm --target=node22 --legal-comments=none \
    "--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);" \
    --outfile=/out/agent-worker.mjs

FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/agent-worker.mjs /app/agent-worker.mjs
COPY apps/demo/worker-entrypoint.sh /app/worker-entrypoint.sh
RUN chmod 0555 /app/worker-entrypoint.sh
ENV NODE_ENV=production \
    EXPECTED_JSON=/run/wraps/expected.json \
    TZ=UTC
ENTRYPOINT ["/app/worker-entrypoint.sh"]
CMD ["node", "/app/agent-worker.mjs"]
