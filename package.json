{
  "name": "wraps",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx apps/demo/src/server.ts",
    "demo:live": "tsx scripts/demo-live.ts",
    "demo:preflight": "tsx scripts/live-preflight.ts",
    "demo:core": "tsx scripts/demo-core.ts",
    "demo:gcp": "tsx scripts/demo-gcp.ts",
    "verify:gcp": "tsx scripts/verify-gcp.ts",
    "issuer": "tsx packages/issuer/src/cli.ts",
    "payout:dry-run": "tsx packages/issuer/src/payout-cli.ts dry-run",
    "payout:once": "tsx packages/issuer/src/payout-cli.ts once",
    "merchant": "tsx packages/merchant/src/cli.ts",
    "merchant:auth-key": "tsx scripts/merchant-auth-key.ts",
    "agent": "tsx packages/agent/src/cli.ts",
    "spybot": "tsx packages/spybot/src/cli.ts",
    "sim": "tsx packages/spybot/src/sim-cli.ts",
    "test": "vitest run && vitest run -c apps/demo/vitest.config.ts",
    "test:conformance": "vitest run conformance --reporter=json --outputFile=node_modules/.cache/conformance.json > /dev/null 2>&1; node -e \"const r=require('./node_modules/.cache/conformance.json');let p=0,f=0;for(const t of r.testResults)for(const a of t.assertionResults){const ok=a.status==='passed';ok?p++:f++;console.log((ok?'PASS  ':'FAIL  ')+a.title)}console.log('\\\\n'+p+' passed, '+f+' failed');process.exit(f||!r.success?1:0)\"",
    "bench": "tsx scripts/bench.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/demo/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
