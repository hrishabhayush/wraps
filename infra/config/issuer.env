# Runtime settings for the issuer host. Sourced by the scripts in infra/scripts.
ROLE=issuer
# The enclave takes whole CPU cores. 2 vCPUs = 1 core on c6i.xlarge.
ENCLAVE_CPUS=2
# Must be <= memory_mib in /etc/nitro_enclaves/allocator.yaml (host-setup.sh writes it).
ENCLAVE_MEMORY_MIB=3072
# Any value >= 4. One enclave per host, so both hosts can use 16.
ENCLAVE_CID=16
# Public TCP port on the parent.
PUBLIC_PORT=443
# Ports inside the enclave. APP_PORT, BOOT_CONFIG_PORT and LOG_PORT are also
# set as ENV in the Dockerfile. Keep them the same.
APP_PORT=8443
BOOT_CONFIG_PORT=7000
LOG_PORT=9000
