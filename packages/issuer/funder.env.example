# RLUSD payout configuration for XRPL EVM Testnet.
# This is a template only. Copy it to an ignored local .env or set the variables in
# the issuer runtime. Never paste a real private key here, commit it, or share it in chat.
#
# Before a live payout:
# 1. Use a fresh testnet issuer wallet and fund it with test XRP for gas and test RLUSD.
# 2. Confirm RLUSD_ADDRESS on the configured XRPL EVM testnet RPC: chain ID 1449000,
#    symbol() RLUSD, and the expected decimals before funding or sending.
# 3. Set each merchant ID to its 0x payout address. Unregistered merchants are not paid.
# 4. Run `npm run payout:dry-run` and check every recipient and amount before `payout:once`.

PAYOUT_RAIL=xrpl-evm
XRPL_EVM_RPC=https://rpc.testnet.xrplevm.org/
XRPL_EVM_CHAIN_ID=1449000

# Required. Generate a testnet-only issuer wallet. Keep this value in the local ignored .env
# or your secret manager; do not put it in this example file.
ISSUER_PAYOUT_PRIVATE_KEY=

# Public address derived from the private key above. The issuer verifies that they match.
ISSUER_PAYOUT=

# XRPL EVM testnet RLUSD contract. Read-only checked 2026-10-25: chain ID 1449000,
# symbol() RLUSD, decimals() 18. Recheck against your configured RPC before funding.
RLUSD_ADDRESS=0x27b57a9d0b8d24eb97259c4e2279e45255e016f3

# Format: merchant-id=0x-address[,another-merchant-id=0x-address]
# Example merchant ID for the local demo: merchant-research-data
MERCHANT_PAYOUT_ADDRESSES=

# Use a long interval for a manual test so payouts do not run unexpectedly.
PAYOUT_INTERVAL_MS=3600000

# Optional: set this to protect payout admin routes. If omitted, they accept loopback callers only.
ISSUER_ADMIN_TOKEN=

# Merchant IDs are authenticated with Ed25519 keys on /settle, /settle/status and /payouts.
# Set the JSON map emitted by `npm run merchant:auth-key -- <merchant-id>`.
ISSUER_MERCHANT_AUTH_KEYS=

# Temporary compatibility credential for the relay's unsigned legacy settle client.
# The relay still needs to send this as `Authorization: Bearer <key>` before strict auth works.
ISSUER_RELAY_SETTLE_KEY=
ISSUER_RELAY_MERCHANT_ID=relay

# Local/non-enclave only. The current Confidential Space image remains in-memory.
# ISSUER_STATE_FILE=./data/issuer-state.jsonl
# ISSUER_DEV_MERCHANT_AUTH=1 requires ISSUER_HOST=127.0.0.1 and ATTESTATION=mock.

# Optional limits. Defaults are enforced by the issuer; leave unset unless you need an override.
# PAYOUT_MAX_LINES=50
# PAYOUT_MAX_BATCH_TOKENS=100000
# PAYOUT_MAX_FEE_RLUSD=1
# PAYOUT_MAX_GAS_PER_TRANSFER=100000
# PAYOUT_MAX_GAS_PRICE_GWEI=100
# PAYOUT_MAX_BATCH_FEE_XRP=0.5
