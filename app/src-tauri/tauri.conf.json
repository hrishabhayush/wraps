{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wraps",
  "version": "0.1.0",
  "identifier": "xyz.wraps.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Wraps",
        "width": 360,
        "height": 600,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node",
      "binaries/wg",
      "binaries/wireguard-go"
    ],
    "resources": [
      "resources/wraps-connect.mjs",
      "resources/wraps-tunnel.sh"
    ]
  }
}
