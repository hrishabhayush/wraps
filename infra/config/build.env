# Build settings shared by both enclave images. Sourced by build-eif.sh.
# Every value here changes PCR0. Change them only on purpose, then rebuild both.

# Fixed timestamp for all files in the image (BuildKit rewrite-timestamp).
# 1792800000 = 2026-10-24T00:00:00Z. Any fixed value works; do not use "now".
SOURCE_DATE_EPOCH=1792800000

# Debian packages (socat, iproute2) come from this snapshot, so apt gives
# the same bytes every time. Format: YYYYMMDDTHHMMSSZ.
DEBIAN_SNAPSHOT=20261020T000000Z

# BuildKit version used for builds. prepare-build.sh pins it by digest.
BUILDKIT_IMAGE=moby/buildkit:v0.16.0

# Name of the buildx builder that build-eif.sh creates.
BUILDX_BUILDER=ifi-repro
